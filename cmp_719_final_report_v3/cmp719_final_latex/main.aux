\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Frame-regime breakdown.} Among the few frames where a vehicle is near a pedestrian, the overwhelming majority are \emph  {anomalous} ($\sim $91\%). On ShanghaiTech a vehicle near a pedestrian almost \emph  {is} the anomaly --- which both motivates a hazard-focused evaluation and warns that this benchmark cannot, by itself, separate ``hazard'' from ``object presence'' (Section~\ref {sec:limitations}).}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:eda2}{{3}{5}{\textbf {Frame-regime breakdown.} Among the few frames where a vehicle is near a pedestrian, the overwhelming majority are \emph {anomalous} ($\sim $91\%). On ShanghaiTech a vehicle near a pedestrian almost \emph {is} the anomaly --- which both motivates a hazard-focused evaluation and warns that this benchmark cannot, by itself, separate ``hazard'' from ``object presence'' (Section~\ref {sec:limitations})}{figure.3}{}}
